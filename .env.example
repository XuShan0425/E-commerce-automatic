# ── Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=ad_manager
DB_PASSWORD=change-me-in-production
DB_NAME=ad_manager

# Async connection string (auto-built, override if needed)
# DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret
ENVIRONMENT=development

# ── Admin (used to bootstrap the first API key) ───
ADMIN_API_KEY=admin-bootstrap-key-change-me

# ── Claude API ────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Email Notification (SMTP) ────────────────────
# 用哪个邮箱发信就填哪组。收件人可以填多个，逗号分隔。
#
# ═══════════════════════════════════════════
# 方案一：用 Gmail 发信 (推荐)
#   1. 登录 Gmail → 管理账户 → 安全性 → 两步验证 (先开启)
#   2. 两步验证开启后，搜索 "App Password" → 生成一个
#   3. 把生成的 16 位密码填到 SMTP_PASSWORD
# ═══════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=@gmail.com
SMTP_PASSWORD=
SMTP_FROM=@gmail.com
#
# ═══════════════════════════════════════════
# 方案二：用 Outlook 发信
#   如果用 Outlook 发，改下面几行，注释掉 Gmail 那组
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your-email@outlook.com
# SMTP_PASSWORD=your-outlook-password
# SMTP_FROM=your-email@outlook.com
# ═══════════════════════════════════════════
#
# ── 收件人（多个用逗号分隔）──
ALERT_EMAIL_TO=
