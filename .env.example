# ── Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=ad_manager
DB_PASSWORD=change-me-in-production
DB_NAME=ad_manager

# Async connection string (auto-built, override if needed)
# DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret
ENVIRONMENT=development

# ── Admin (used to bootstrap the first API key) ───
ADMIN_API_KEY=admin-bootstrap-key-change-me

